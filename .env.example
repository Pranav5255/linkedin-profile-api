APP_ENV=
# Any string you choose. Change it anytime, restart the API, then send the new value as X-API-Key.
API_KEY=
DEMO_API_KEY=
LINKEDIN_COOKIE_JAR=
LINKEDIN_COOKIE_JAR_FAILOVER=
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
LINKEDIN_LI_AT_FAILOVER=
LINKEDIN_JSESSIONID_FAILOVER=
LINKEDIN_EGRESS_PROXY=
LINKEDIN_IMPERSONATE=chrome124
CACHE_DATABASE_PATH=/data/cache.db
CACHE_TTL_SECONDS=21600
MAX_UPSTREAM_CONCURRENCY=1
