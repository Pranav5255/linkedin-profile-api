REQUEST_DEADLINE_SECONDS=360
UPSTREAM_DELAY_MS_MIN=800
UPSTREAM_DELAY_MS_MAX=2000
BUNDLE_FETCH_TIMEOUT_SECONDS=8
BUNDLE_MAX_BYTES=2097152
BUNDLE_MAX_ASSETS=6
SESSION_STALE_AFTER_SECONDS=900
SESSION_PROBE_INTERVAL_SECONDS=300
LINKEDIN_DECOY_FEED=false
CAPTURED_ENDPOINTS_PATH=data/captured-endpoints.json
LOG_LEVEL=INFO
DUCKDNS_HOSTNAME=
